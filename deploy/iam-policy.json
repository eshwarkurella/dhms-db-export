{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteExportsToS3",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::your-bucket-name/DHMS/*"
    },
    {
      "Sid": "ReadDbPassword",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-south-1:YOUR_ACCOUNT_ID:secret:dhms/staging/db-*"
    }
  ]
}
